{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hraness immutable source lock",
  "type": "object",
  "required": ["schemaVersion", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "canonicalUrl", "revision", "upstreamPaths", "license", "localPaths"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "canonicalUrl": { "type": "string", "pattern": "^https://" },
          "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "upstreamPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "license": { "type": "string", "minLength": 3 },
          "localPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "attribution": { "type": "string" },
          "permissionNote": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
