{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hraness Skillpack catalog",
  "type": "object",
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "plugin", "owner", "positive", "negative"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "plugin": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "owner": { "type": "string", "minLength": 12 },
          "positive": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
          "negative": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } }
          ,"adjacent": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
